# Apartment Hunter settings. Copy this file to .env and fill in DISCORD_TOKEN; the rest is optional.

# Required: your bot's token (Discord Developer Portal -> your application -> Bot -> Reset Token).
# Keep it secret: anyone with it can run your bot.
DISCORD_TOKEN=

# Folder for the database and logs (default: data)
# DATA_DIR=data

# Your Discord user id, to get a direct message when a site stops working for every search
# (Discord: Settings -> Advanced -> Developer Mode, then right-click your name -> Copy User ID)
# OWNER_USER_ID=

# A server id for testing: commands appear there at once instead of globally (which can take an hour)
# DEV_GUILD_ID=

# Minutes between checks of each search (default 15, minimum 10)
# INTERVAL_MINUTES=15

# Most searches one server may have (default 5), and for the whole bot (default 25)
# MAX_SEARCHES_PER_SERVER=5
# MAX_SEARCHES_TOTAL=25

# Only these servers may use the bot: server ids separated by commas (default: any server)
# ALLOWED_SERVERS=

# How much to log: DEBUG, INFO, WARNING, ERROR or CRITICAL (default INFO)
# LOG_LEVEL=INFO
